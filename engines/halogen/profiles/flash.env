# halogen: профиль flash — файл-переменные (формат v2, P_*; контракт
# полей и имена — core/profiles.sh; core читает только 1–5 =
# P_MODEL/P_MODELS/P_DRAFT/P_RAM_GIB/P_DESC, 6+ — диалект адаптера).
# Дефолты не задаются: каждое значение явное — «один факт — одно место».

P_MODEL="qwen38-flash-next-v2.hgn"
P_MODELS="qwen38-flash-next-v2.hgn qwen38-flash-next-ngram.hgn qwen38-flash-next-drafter-r2-ht4.hgn qwen38-flash-next-vision.hgn tokenizer/chat_template.jinja tokenizer/generation_config.json tokenizer/merges.txt tokenizer/tokenizer.json tokenizer/tokenizer_config.json tokenizer/vocab.json"
P_DRAFT="qwen38-flash-next-drafter-r2-ht4.hgn"
# 110: the weights 62 GiB + the KV pool 524288 (~27 GiB at 2×262144) + a
# prefill scratch ~9 GiB ≈ 100+ GiB; on a 60 GiB machine the core refuses
# normally (profile_gate before any downloading)
P_RAM_GIB=110
P_DESC="halogen-flash (concurrency mode, KV_SLOTS 4 × ctx 262144, пул 524288, prompt-cache disk 64G)"
# 4 = the image default and the upstream admission policy (a slot ~57 MB;
# «a latency policy, not a memory decision»: the 3rd/4th client lands in a
# joint round + SPEC_GROUP=4 instead of the slot queue; CACHE_ENTRIES=28
# covers exactly 4 conversations; the aider #51 case: the per-turn wall
# 42s@4 vs 52s@2. The 2×CTX pool stays — the per-request context does not
# change. Was 2 (the gufo parity) — the Ф3 docs revision, 2026-11-26)
P_SESSIONS=4
# 262144 — the model's native context (the HALOGEN_CTX image default is the
# same — not rendered into the golden)
P_CTX=262144
# halogen's RAM tier is not configurable (the KV pool is a separate
# mechanism) → ram=0 (the display «—»), disk= 64 GiB (the CACHE_DISK_GIB
# image default matches — the /cache mount in the golden makes it work)
P_CACHE_RAM=0
P_CACHE_DISK=68719476736
# '-' — halogen has no CLI; the engine config is envs, rendered by the golden
# (stack_files.sh). The HALOGEN_KV_POOL_POSITIONS pool is not set: the 2×CTX
# default + KV_POOL_FIT=1 (the engine shrinks it itself on shortage and says
# so in the log) — an F21 analog: fit.
P_SERVE_ARGS="-"
P_PROBE_LADDER="-"

# эталоны agent-check (cmp_ref ±25%); отсутствующая = «не снят» (WARN)
P_REF_SESSION="17.69"   # a session of 15 turns, total wall
P_REF_FOLLOWUP="0.97"   # the 25k follow-up, turn2 wall (k5 1.11 / k100 1.05)
P_REF_DOCQ="1.13"   # [док 25k][q2] turn2 wall (cache_n=27008)
P_REF_RESTORE="1.34"   # the restart-restore 25k turn2, cache_n=27008 (disk)
