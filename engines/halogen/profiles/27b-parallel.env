# halogen: профиль 27b-parallel — файл-переменные (формат v2, P_*; контракт
# полей и имена — core/profiles.sh). 2 параллельных запроса на evo
# (60 GiB): KV_SLOTS 2 × ctx 210000, пул 2×CTX=420096 позиций
# ФОРСИРОВАН (P_KV_POOL_FIT=0): авто-fit ужал бы пул до пола 1×CTX
# (F41) — тогда второй полный запрос невозможен. Решение владельца
# 2026-11-28 (EXP-015): 2×210k — канон despite деградации декода на
# глубоком параллельном заполнении (footprint 55.4 GiB, evictions;
# на частичном пуле и в соло декод здоров 17-33 t/s). Гейт 56 = леджер
# 55.4 + округление; машина 59 GiB. (формат v2, P_*; контракт
# полей и имена — core/profiles.sh; core читает только 1–5 =
# P_MODEL/P_MODELS/P_DRAFT/P_RAM_GIB/P_DESC, 6+ — диалект адаптера).
# Дефолты не задаются: каждое значение явное — «один факт — одно место».
# Чекпоинт halogen-qwen3.8-27b-ht4 (обслуживается 0.21.0+, сервер выбирает
# движок из чекпоинта; model id API — halogen-qwen3.8-27b, README репо).

P_MODEL="qwen38-27b-ht4.hgn"
P_MODELS="qwen38-27b-ht4.hgn qwen38-27b-vision.hgn tokenizer/chat_template.jinja tokenizer/generation_config.json tokenizer/merges.txt tokenizer/tokenizer.json tokenizer/tokenizer_config.json tokenizer/vocab.json"
# draft-голова ВНУТРИ чекпоинта (ht4) — отдельного drafter/ngram-файла
# у сета нет (flash-next рядом требовал ngram.hgn — 27b не требует);
# "-" = поля pull пропускают (core/models.sh: draft пуст или '-' → skip)
P_DRAFT="-"
# калибровка по стартовому леджеру 0.21.0 (первый старт 2026-11-28):
# веса 12.84+0.86 (измерено, pinned) + KV-пул 524288 позиций ~36.5 +
# рабочая ~12.6 + prompt-cache 4.2 + n-gram/OS-резерв 20 ≈ 87 GiB —
# гейт 90 (движковый pre-flight считает ~90; пул не сужался —
# KV_POOL_FIT не понадобился)
P_RAM_GIB=56
P_DESC="halogen-27b-parallel (evo 60 GiB: KV_SLOTS 2 × ctx 210000, пул 420096 форсирован, KV_POOL_FIT=0)"
# та же слотовая политика, что у flash (слот ~shared pool, 4 = admission
# policy движка); KV-пул — 2×CTX позиций, не slots×ctx
P_SESSIONS=2
P_CTX=210000
# halogen's RAM tier is not configurable (the KV pool is a separate
# mechanism) → ram=0 (the display «—»), disk= 64 GiB (the CACHE_DISK_GIB
# image default matches — the /cache mount in the golden makes it work)
P_CACHE_RAM=0
P_CACHE_DISK=68719476736
# '-' — halogen has no CLI; the engine config is envs, rendered by the golden
P_SERVE_ARGS="-"
P_PROBE_LADDER="-"
# канон model id API (в /v1/models, эхо ответов; README репо 27b-ht4) —
# адаптерный диалект (поле вне контракта 1–9, читается model_id_canon)
P_MODEL_ID="halogen-qwen3.8-27b"

# эталоны agent-check (cmp_ref ±25%): НЕ СНЯТЫ — первая приёмка 27b-профиля
# снимет их живьём (появившаяся строка = снимок первого прогона)
# форс пула: 0 = аллокатор резервирует заказанные 2×CTX без авто-ужимания
# (fit-модель движка консервативна и на 59 GiB всегда урезала бы до пола)
P_KV_POOL_FIT="0"
