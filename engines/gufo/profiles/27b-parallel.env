# gufo: профиль 27b-parallel — файл-переменные (формат v2, P_*; контракт
# полей и имена — core/profiles.sh; core читает только 1–5 =
# P_MODEL/P_MODELS/P_DRAFT/P_RAM_GIB/P_DESC, 6+ — диалект адаптера).
# Дефолты не задаются: каждое значение явное — «один факт — одно место».
# эталоны ref_27b_parallel_* не снимались (legacy-реестр их не имел) — cmp_ref всегда WARN «не снят».

P_MODEL="qwen3.8-27b-IQ4_XS-pure.gguf"
P_MODELS="qwen3.8-27b-IQ4_XS-pure.gguf mmproj-BF16.gguf"
P_DRAFT="Qwen3.8-27B-DFlash2-Q4_K_M.gguf"
P_RAM_GIB=56
P_DESC="мульти DFlash2 (probe-лестница, D5)"
P_SESSIONS=2
P_CTX=210000
P_CACHE_RAM=12884901888
P_CACHE_DISK=68719476736
P_SERVE_ARGS="--speculative dflash2 --dflash-model @DRAFT@ --mmproj @MMPROJ@ --log-progress --served-model-name qwen3.8-27b --served-model-name Qwen3.8-27B --served-model-name qwen3.8:27b-mq4-xts"
P_PROBE_LADDER="210000 196608 163840 131072"
