# hipfire: профиль 27b — файл-переменные (формат v2, P_*; контракт
# полей и имена — core/profiles.sh; core читает только 1–5 =
# P_MODEL/P_MODELS/P_DRAFT/P_RAM_GIB/P_DESC, 6+ — диалект адаптера).
# Дефолты не задаются: каждое значение явное — «один факт — одно место».

P_MODEL="qwen3.8:27b-mq4-xts"
P_MODELS="qwen3.8:27b-mq4-xts"
P_DRAFT="qwen3.8:27b-draft-mq4"
P_RAM_GIB=58
P_DESC="singleton+DFlash (максимум соло-скорости)"
